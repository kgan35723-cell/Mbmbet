  0% { left: -100%; }
  65%, 100% { left: 150%; }
}

@keyframes abcRedPulse { 
  0%, 100% { box-shadow: rgba(220, 0, 40, 0.4) 0px 4px 15px, rgba(255, 180, 50, 0.2) 0px 0px 5px; }
  50% { box-shadow: rgba(220, 0, 40, 0.6) 0px 4px 20px, rgba(255, 200, 70, 0.6) 0px 0px 15px; }
