.abc-premium-download { flex: 1 1 0%; min-width: 0px; display: flex; align-items: center; justify-content: center; gap: 12px; height: 66px; min-height: 66px; padding: 8px 14px; box-sizing: border-box; overflow: hidden; border: 2px solid rgb(255, 211, 106); border-radius: 13px; background: linear-gradient(110deg, rgb(160, 0, 22), rgb(230, 0, 45), rgb(255, 64, 87), rgb(201, 0, 37)) 0% 0% / 200% 200%; font-family: Arial, sans-serif; box-shadow: rgba(220, 0, 40, 0.45) 0px 4px 15px, rgba(255, 180, 50, 0.25) 0px 0px 10px, rgba(255, 255, 255, 0.2) 0px 1px 5px inset; animation: 2s ease-in-out 0s infinite normal none running abcRedPulse, 5s ease 0s infinite normal none running abcRedBackground; position: relative !important; color: rgb(255, 255, 255) !important; text-decoration: none !important; }

.abc-premium-download::before { content: ""; position: absolute; top: 0px; left: -100%; width: 45%; height: 100%; background: linear-gradient(110deg, transparent, rgba(255, 255, 255, 0.5), transparent); transform: skewX(-25deg); animation: 2.5s ease 0s infinite normal none running abcMovingShine; pointer-events: none; }

.abc-download-icon { width: 38px; height: 38px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(145deg, rgb(255, 245, 197), rgb(255, 189, 53)); box-shadow: rgba(0, 0, 0, 0.25) 0px 2px 9px; position: relative; z-index: 2; }

