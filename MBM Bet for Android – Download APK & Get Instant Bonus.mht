.abc-download-title { font-size: 18px; font-weight: 900; letter-spacing: 1px; text-shadow: rgba(0, 0, 0, 0.3) 0px 2px 4px; color: rgb(255, 255, 255) !important; }

.abc-download-subtitle { font-size: 10px; font-weight: 700; margin-top: 3px; color: rgb(255, 241, 189) !important; }

.abc-download-arrow { flex-shrink: 0; font-size: 23px; font-weight: bold; position: relative; z-index: 2; animation: 1s ease 0s infinite normal none running abcArrowMove; color: rgb(255, 225, 138) !important; }

.abc-see-more { flex-shrink: 0; width: 105px; height: 66px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; box-sizing: border-box; border: 2px solid rgb(166, 246, 255); border-radius: 13px; background: linear-gradient(135deg, rgb(0, 43, 98), rgb(0, 107, 224), rgb(0, 169, 201)); font-family: Arial, sans-serif; font-size: 13px; font-weight: 900; letter-spacing: 0.6px; box-shadow: rgba(0, 130, 255, 0.4) 0px 4px 15px, rgba(255, 255, 255, 0.2) 0px 1px 5px inset; position: relative; overflow: hidden; transition: 0.3s; color: rgb(255, 255, 255) !important; text-decoration: none !important; }

.abc-see-more::before { content: ""; position: absolute; inset: 0px; border-radius: 11px; border: 1px solid rgba(255, 255, 255, 0.35); pointer-events: none; }

.abc-see-more .abc-internet-icon { width: 27px; height: 27px; display: flex; align-items: center; justify-content: center; position: relative; z-index: 2; animation: 1.5s ease-in-out 0s infinite normal none running abcInternetGlow; }

.abc-internet-icon svg { width: 25px; height: 25px; fill: none; stroke: rgb(255, 255, 255); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; animation: 8s linear 0s infinite normal none running abcInternetRotate; filter: drop-shadow(rgb(128, 245, 255) 0px 0px 5px); }

